@baseUrl = http://localhost:5126

### =========================================================
### AUTHENTICATION
### =========================================================

### Register test user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "week7test2@example.com",
  "password": "Week7Test123",
  "name": "Week Seven Test"
}

###

### Login primary test user
# @name primaryLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "week7test@example.com",
  "password": "Week7Test123"
}

###

### Login second user
# @name secondLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "week7test2@example.com",
  "password": "Week7Test123"
}

###

### Create account for second user
# @name secondAccountCreate
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{secondLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Second User Account",
  "currency": "EUR",
  "startAmount": 500.00
}

###

### Demo login
# @name demoLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@fintracker.local",
  "password": "Demo12345"
}


### =========================================================
### USERS
### =========================================================

### Current primary user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}

###

### Update current primary user
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Week Seven User Updated"
}


### =========================================================
### ACCOUNTS
### =========================================================

### Get accounts
GET {{baseUrl}}/api/accounts?includeArchived=false
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}

###

### Create primary user's account
# @name primaryAccountCreate
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Savings Account",
  "currency": "USD",
  "startAmount": 1000.00
}

###

### Get created account
GET {{baseUrl}}/api/accounts/{{primaryAccountCreate.response.body.$.id}}
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}

###

### Update created account
PUT {{baseUrl}}/api/accounts/{{primaryAccountCreate.response.body.$.id}}
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Updated Savings Account",
  "currency": "USD",
  "startAmount": 1500.00
}

###

### Archive created account
PATCH {{baseUrl}}/api/accounts/{{primaryAccountCreate.response.body.$.id}}/archive
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "isArchived": true
}

###

### Get accounts including archived
GET {{baseUrl}}/api/accounts?includeArchived=true
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}

###

### Unarchive created account
PATCH {{baseUrl}}/api/accounts/{{primaryAccountCreate.response.body.$.id}}/archive
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "isArchived": false
}

###

### Delete created account
DELETE {{baseUrl}}/api/accounts/{{primaryAccountCreate.response.body.$.id}}
Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}


