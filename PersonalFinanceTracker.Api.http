Authorization: Bearer {{primaryLogin.response.body.$.accessToken}}


### =========================================================
### WEEK 8 - OPERATIONS
### =========================================================

### Get operations - default paging/sorting
GET {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Get operations with paging
GET {{baseUrl}}/api/operations?page=1&pageSize=10
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Filter operations by account
GET {{baseUrl}}/api/operations?accountId=c0000000-0000-0000-0000-000000000002&page=1&pageSize=20
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Filter Expense operations
GET {{baseUrl}}/api/operations?type=Expense&page=1&pageSize=20
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Filter operations by date
GET {{baseUrl}}/api/operations?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Sort operations by amount descending
GET {{baseUrl}}/api/operations?sortBy=amountDesc
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Create operation
# @name createOperation
POST {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": 1250.00,
  "date": "2026-10-05",
  "comment": "Groceries"
}

###

### Get created operation
GET {{baseUrl}}/api/operations/{{createOperation.response.body.$.id}}
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Update created operation
PUT {{baseUrl}}/api/operations/{{createOperation.response.body.$.id}}
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000002",
  "type": "Expense",
  "amount": 1500.00,
  "date": "2026-10-05",
  "comment": "Dinner"
}

###

### Delete created operation
DELETE {{baseUrl}}/api/operations/{{createOperation.response.body.$.id}}
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}


### =========================================================
### OPERATION BUSINESS RULE TESTS
### =========================================================

### R2 - Amount must be positive - expect 400
POST {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": -10.00,
  "date": "2026-10-05",
  "comment": "Invalid amount"
}

###

### R2 - More than two decimal places - expect 400
POST {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": 10.123,
  "date": "2026-10-05",
  "comment": "Invalid decimals"
}

###

### R3 - Category type mismatch - expect 400
POST {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "a0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": 100.00,
  "date": "2026-10-05",
  "comment": "Wrong category type"
}

###

### R4 - Future operation date - expect 400
POST {{baseUrl}}/api/operations
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": 100.00,
  "date": "2027-01-01",
  "comment": "Future operation"
}

###

### Invalid paging - expect 400
GET {{baseUrl}}/api/operations?page=0&pageSize=20
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Invalid pageSize - expect 400
GET {{baseUrl}}/api/operations?page=1&pageSize=101
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Invalid operation date range - expect 400
GET {{baseUrl}}/api/operations?from=2026-10-20&to=2026-10-01
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

###

### Invalid operation sort - expect 400
GET {{baseUrl}}/api/operations?sortBy=wrongSort
Authorization: Bearer {{demoLogin.response.body.$.accessToken}}

