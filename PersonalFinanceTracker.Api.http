### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "week7test2@example.com",
  "password": "Week7Test123",
  "name": "Week Seven Test"
}


### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "week7test@example.com",
  "password": "Week7Test123"
}

### Login second user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "week7test2@example.com",
  "password": "Week7Test123"
}

### Create account for second user
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "name": "Second User Account",
  "currency": "EUR",
  "startAmount": 500.00
}

### Login demo user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@fintracker.local",
  "password": "Demo12345"
}

### Current user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}

### Update current user
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Week Seven User Updated"
}

### Get accounts
GET {{baseUrl}}/api/accounts?includeArchived=false
Authorization: Bearer {{token}}

### Create account
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Savings Account",
  "currency": "USD",
  "startAmount": 1000.00
}

### Get one account
GET {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{token}}

### Update account
PUT {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Savings Account",
  "currency": "USD",
  "startAmount": 1500.00
}

### Archive account
PATCH {{baseUrl}}/api/accounts/{{accountId}}/archive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isArchived": true
}

### Get accounts including archived
GET {{baseUrl}}/api/accounts?includeArchived=true
Authorization: Bearer {{token}}

### Unarchive account
PATCH {{baseUrl}}/api/accounts/{{accountId}}/archive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isArchived": false
}

### Delete account
DELETE {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{token}}


### ================================
### CATEGORIES
### ================================

### Get all categories
GET {{baseUrl}}/api/categories
Authorization: Bearer {{token}}

### Get expense categories
GET {{baseUrl}}/api/categories?type=Expense
Authorization: Bearer {{token}}

### Create category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Travel",
  "type": "Expense"
}

### R10 - Duplicate category - expect 409
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Travel",
  "type": "Expense"
}

### Update category
PUT {{baseUrl}}/api/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Holiday Travel"
}

### R11 - Rename system category - expect 403
PUT {{baseUrl}}/api/categories/a0000000-0000-0000-0000-000000000001
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "New Salary"
}

### Category does not exist - expect 404
PUT {{baseUrl}}/api/categories/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Test"
}

### Delete category
DELETE {{baseUrl}}/api/categories/{{categoryId}}
Authorization: Bearer {{token}}
### Account does not exist - expect 404
GET {{baseUrl}}/api/accounts/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{token}}

### R15 - Other user's account - expect 403
GET {{baseUrl}}/api/accounts/{{otherUserAccountId}}
Authorization: Bearer {{token}}

### R6 - Delete used account - expect 409
DELETE {{baseUrl}}/api/accounts/{{demoDebitAccountId}}
Authorization: Bearer {{demoToken}}
### Get demo accounts
GET {{baseUrl}}/api/accounts?includeArchived=false
Authorization: Bearer {{demoToken}}

### R7 - Change currency of used account - expect 409
PUT {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "name": "Debit card",
  "currency": "USD",
  "startAmount": 42000.00
}
