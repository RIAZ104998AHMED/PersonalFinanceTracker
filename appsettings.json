{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "PersonalFinanceTracker.Api",
    "Audience": "PersonalFinanceTracker.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Currencies": {
    "Allowed": [
      "RUB",
      "USD",
      "EUR",
      "CNY",
      "KZT",
      "GBP"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}